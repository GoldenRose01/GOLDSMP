[Unit]
Description=GOLDSMP - Lightweight Rust Application Management Panel
After=network.target

[Service]
Type=simple
User=goldsmp
WorkingDirectory=/opt/goldsmp
Environment=GOLDSMP_PORT=8080
Environment=GOLDSMP_DATA_DIR=/var/lib/goldsmp
Environment=GOLDSMP_JWT_SECRET=change-this-to-a-long-random-secret
ExecStart=/opt/goldsmp/goldsmp
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
