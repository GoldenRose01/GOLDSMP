[Unit]
Description=GOLDSMP - Lightweight Rust Application Management Panel
After=network.target

[Service]
Type=simple
User=goldsmp
WorkingDirectory=/opt/goldsmp
Environment=GOLDSMP_PORT=8080
Environment=GOLDSMP_DATA_DIR=/var/lib/goldsmp
Environment=GOLDSMP_JWT_SECRET=change-this-to-a-long-random-secret
Environment=GOLDSMP_OAUTH_CLIENT_FILE=/var/lib/goldsmp/oauth_client.json
Environment=GOLDSMP_OAUTH_CLIENT_ID=
Environment=GOLDSMP_OAUTH_CLIENT_SECRET=
Environment=GOLDSMP_OAUTH_REDIRECT_URI=http://localhost:8080/api/gdrive/callback
Environment=GOLDSMP_OIDC_ISSUER_URL=
Environment=GOLDSMP_OIDC_CLIENT_ID=
Environment=GOLDSMP_OIDC_CLIENT_SECRET=
ExecStart=/opt/goldsmp/goldsmp
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

